% First cited in Chapter 4. The 8.4 Reference Manual documents that
% explain_json_format_version selects JSON format version 2, but the field-level
% semantics of that version (access_type holding the iterator kind, with the
% traditional access type moved to index_access_type) are documented in the
% MySQL Server Team's announcement post, which is where the claim is sourced.
@misc{mysqlblogjson,
  author       = {Brevik, Magnus},
  title        = {New {JSON} format for {EXPLAIN}},
  howpublished = {\url{https://dev.mysql.com/blog-archive/new-json-format-for-explain/}},
  year         = {2024},
  note         = {MySQL Server Team Blog; pristupljeno 26. avgusta 2026}
}

