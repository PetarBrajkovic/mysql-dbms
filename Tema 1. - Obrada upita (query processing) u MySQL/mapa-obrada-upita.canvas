      "label": "šav ipak nije zatvoren"
    },
    {
      "id": "e007",
      "fromNode": "n2d",
      "fromSide": "bottom",
      "toNode": "n2e",
      "toSide": "top",
      "label": "šta kojoj strani pripada"
    },
    {
      "id": "e008",
      "fromNode": "n3a",
      "fromSide": "bottom",
      "toNode": "n3c",
      "toSide": "top",
      "label": "sve što ima alternativu svodi se na jedan broj",
      "color": "1"
    },
    {
      "id": "e009",
      "fromNode": "n3c",
      "fromSide": "bottom",
      "toNode": "n3b",
      "toSide": "top",
      "label": "ali priprema nema alternativu, pa nema ni cenu"
    },
    {
      "id": "e010",
      "fromNode": "n3b",
